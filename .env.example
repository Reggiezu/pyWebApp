MYSQL_ROOT_PASSWORD=<INSERT_PASS>
MYSQL_USER=<INSERT_USER>
MYSQL_PASSWORD=<INSERT_PASS>
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Use 127.0.0.1 locally. The default is 12wy-mysql, the container name.
MYSQL_HOST=127.0.0.1
# Default is 3306. Use 3307 if your Mac's own MySQL holds 3306.
MYSQL_PORT=3306